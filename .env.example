# ---- LLM ----
# Only LLM_API_KEY is strictly required. The other LLM_* fields are
# fallback defaults — config/experiments.yaml entries can override them
# per-experiment (so one .env covers a batch hitting different models).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-5.4-2026-03-05

# ---- Project root (optional) ----
# Where `real_data/` and `results/` live. Unset = both default to under
# the repo (current behavior). On a cloud box where you want both the
# uploaded data and the run outputs on a mounted persistent disk, set
# this to that disk's directory:
#   SSDA_ROOT=/mnt/disk2/ssda
# That dir should mirror the repo layout — i.e. it should contain a
# `real_data/` subdir (you upload it) and a `results/` subdir (auto-
# created on first run).
# SSDA_ROOT=
