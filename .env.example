# ---- LLM ----
# Only LLM_API_KEY is strictly required. The other LLM_* fields are
# fallback defaults — config/experiments.yaml entries can override them
# per-experiment (so one .env covers a batch hitting different models).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-5.4-2026-03-05

# ---- Project root (optional) ----
# Where `real_data/`, `ssdatabench/`, and `results/` live. Unset = all
# three default to under the repo (current behavior). On a cloud box
# where you want the uploaded data, the third-party scoring suite, and
# the run outputs all on a mounted persistent disk, set this to that
# disk's directory:
#   SSDA_ROOT=/mnt/disk2/ssda
# That dir should mirror the repo layout — i.e. it should contain
# `real_data/` (you upload it), `ssdatabench/` (you upload it), and a
# `results/` subdir (auto-created on first run).
# SSDA_ROOT=

# ---- Per-tree overrides (advanced, optional) ----
# Each of the three trees can be relocated independently of SSDA_ROOT.
# Set these only if you want a split (e.g. data on a fast SSD, results
# on a cheap large disk). Unset = derived from SSDA_ROOT (or repo).
# SSDA_DATA_ROOT=/mnt/fast/real_data
# SSDA_RESULTS_ROOT=/mnt/large/results
# SSDA_SSDATABENCH_ROOT=/opt/ssdatabench
