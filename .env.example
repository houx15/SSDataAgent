# ---- LLM ----
# Only LLM_API_KEY is strictly required. The other LLM_* fields are
# fallback defaults — config/experiments.yaml entries can override them
# per-experiment (so one .env covers a batch hitting different models).
LLM_PROVIDER=openai
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=sk-replace-me
LLM_MODEL=gpt-5.4-2026-03-05

# ---- Data location (optional) ----
# Where the cleaned survey CSVs live. Unset = ./real_data/ under the repo
# (the default). On a cloud box where data lives on a separate disk, point
# this at that disk; the leading "real_data/" in config/datasets.yaml is
# stripped, so SSDA_DATA_ROOT *is* the data dir. Example:
#   SSDA_DATA_ROOT=/mnt/disk2/survey_data
# That dir should then contain `used_dataset/sampled_gss.csv` etc., the
# same layout as the repo's real_data/ subtree.
# SSDA_DATA_ROOT=
